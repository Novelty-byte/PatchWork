# Server Configuration
PORT=5000
FRONTEND_URL=https://patch-work-rho.vercel.app

# Make.com Automation Webhook (Recommended - Sends emails automatically without app passwords)
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/your-custom-webhook-id
SOCIETY_MANAGER_EMAIL=society-manager@gmail.com

# Vapi Configuration (Voice Agent)
VAPI_API_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id

# Google Gemini / Vision API (For native AI Chatbot & Photo Verification)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Optional Direct Gmail SMTP (Alternative fallback)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
