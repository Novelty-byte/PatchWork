# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# OPTION A: Make.com Webhook (Recommended - No App Password Needed!)
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/your-custom-webhook-id

# OPTION B: Direct Gmail SMTP Configuration (Alternative)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SOCIETY_MANAGER_EMAIL=society-manager@gmail.com

# Vapi Configuration (Voice Agent)
VAPI_API_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id

# Google Gemini / Vision API
GEMINI_API_KEY=your_gemini_api_key
